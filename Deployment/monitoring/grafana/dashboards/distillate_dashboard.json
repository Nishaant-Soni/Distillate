{
  "title": "Distillate: service, canary and drift",
  "uid": "distillate-monitoring",
  "tags": ["distillate", "draft"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "description": "Draft against the mock exporter (Deployment/monitoring/mock_service.py). Thresholds: thresholds.md.",
  "panels": [
    {"type": "row", "title": "Service (v4 2.4 metrics)", "id": 1, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {"type": "timeseries", "title": "Latency p50 / p90 / p95", "id": 2,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
     "description": "The 50 ms line is v4 section 6's budget for the int8 package; the fp32 model's CPU p95 is 144 ms (README 3.3).",
     "fieldConfig": {"defaults": {"unit": "s",
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]},
       "custom": {"thresholdsStyle": {"mode": "line"}}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "p50",
        "expr": "histogram_quantile(0.5, sum by (le) (rate(distillate_request_latency_seconds_bucket[5m])))"},
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "legendFormat": "p90",
        "expr": "histogram_quantile(0.9, sum by (le) (rate(distillate_request_latency_seconds_bucket[5m])))"},
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "C", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(distillate_request_latency_seconds_bucket[5m])))"}]},
    {"type": "timeseries", "title": "Requests per second", "id": 3,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "rps",
        "expr": "rate(distillate_requests_total[5m])"}]},
    {"type": "timeseries", "title": "Error rate", "id": 4,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.02}]},
       "custom": {"thresholdsStyle": {"mode": "line"}, "axisSoftMax": 0.05}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "errors",
        "expr": "rate(distillate_errors_total[5m]) / clamp_min(rate(distillate_requests_total[5m]), 1e-9)"}]},
    {"type": "text", "title": "Instances (Phase 3)", "id": 5,
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
     "options": {"mode": "markdown", "content": "Cloud Run instance count comes from Google Cloud Monitoring (`run.googleapis.com/container/instance_count`) once the service is deployed and its metrics flow through Managed Service for Prometheus (v4 section 6). Not emitted by the mock."}},

    {"type": "row", "title": "Decisions", "id": 6, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}},
    {"type": "timeseries", "title": "Overall flag rate", "id": 7,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
     "description": "Share of comments flagged on any label: the decision the demo app and moderation queue use.",
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "flag",
        "expr": "rate(distillate_flag_total[5m]) / clamp_min(rate(distillate_requests_total[5m]), 1e-9)"}]},
    {"type": "timeseries", "title": "Flagged rate per label", "id": 8,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{label}}",
        "expr": "rate(distillate_flagged_total[5m]) / ignoring(label) group_left clamp_min(rate(distillate_requests_total[5m]), 1e-9)"}]},
    {"type": "timeseries", "title": "Low-confidence rate", "id": 9,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
     "description": "Answers within 0.1 of a label threshold (v4 2.4).",
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "low confidence",
        "expr": "rate(distillate_low_confidence_total[5m]) / clamp_min(rate(distillate_requests_total[5m]), 1e-9)"}]},
    {"type": "timeseries", "title": "Median score per label", "id": 10,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
     "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{label}}",
        "expr": "histogram_quantile(0.5, sum by (le, label) (rate(distillate_score_bucket[5m])))"}]},

    {"type": "row", "title": "Canary (scripts/canary.py)", "id": 11, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}},
    {"type": "timeseries", "title": "Canary mean AUC", "id": 12,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35},
     "description": "Alert: more than 0.02 below the 7-day average for 3 runs (thresholds.md).",
     "fieldConfig": {"defaults": {"custom": {"axisSoftMin": 0.5, "axisSoftMax": 1}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{set}}",
        "expr": "distillate_canary_mean_auc"},
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "legendFormat": "{{set}} 7-day average",
        "expr": "avg_over_time(distillate_canary_mean_auc[7d])"}]},
    {"type": "timeseries", "title": "Canary AUC per label", "id": 13,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
     "description": "Civil covers five labels (no severe_toxicity, v4 2.2).",
     "fieldConfig": {"defaults": {"custom": {"axisSoftMin": 0.5, "axisSoftMax": 1}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{set}} {{label}}",
        "expr": "distillate_canary_auc"}]},
    {"type": "timeseries", "title": "Canary flag precision and recall", "id": 14,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43},
     "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{set}} precision",
        "expr": "distillate_canary_flag_precision"},
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "legendFormat": "{{set}} recall",
        "expr": "distillate_canary_flag_recall"},
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "C", "legendFormat": "{{set}} {{label}} F1",
        "expr": "distillate_canary_f1"}]},
    {"type": "timeseries", "title": "Time since last canary run", "id": 15,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 43},
     "fieldConfig": {"defaults": {"unit": "s",
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 7200}]},
       "custom": {"thresholdsStyle": {"mode": "line"}}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "age",
        "expr": "time() - distillate_canary_last_run_timestamp_seconds"}]},

    {"type": "row", "title": "Drift (drift_ingest_dag, scripts/drift.py)", "id": 16, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 51}},
    {"type": "timeseries", "title": "Input drift PSI, against the start of the Civil stream (planned)", "id": 17,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 52},
     "description": "Planned: distillate_drift_psi is exported by drift_ingest_dag in Phase 3, and the civil_start reference isn't built yet. Acts on warn (0.1) and alert (0.25); the reference is the start of the stream, so the fixed Wikipedia-to-Civil shift doesn't fire.",
     "fieldConfig": {"defaults": {"min": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 0.25}]},
       "custom": {"thresholdsStyle": {"mode": "line"}}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{feature}}",
        "expr": "distillate_drift_psi{reference=\"civil_start\"}"}]},
    {"type": "timeseries", "title": "Input drift PSI, against Wikipedia train (planned)", "id": 18,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52},
     "description": "Planned: exported by drift_ingest_dag in Phase 3. Expect warn on every Civil batch (domain shift: non-alpha share 0.11 to 0.18, OOV up to 0.13); only alert-level PSI is acted on.",
     "fieldConfig": {"defaults": {"min": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 0.25}]},
       "custom": {"thresholdsStyle": {"mode": "line"}}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "{{feature}}",
        "expr": "distillate_drift_psi{reference=\"wikipedia_train\"}"}]},
    {"type": "timeseries", "title": "Delayed-label mean AUC, previous batch (planned)", "id": 19,
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 60},
     "description": "Planned: exported by drift_ingest_dag in Phase 3. Gold labels attached one batch late; five Civil labels.",
     "fieldConfig": {"defaults": {"custom": {"axisSoftMin": 0.5, "axisSoftMax": 1}}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "legendFormat": "mean AUC",
        "expr": "distillate_delayed_label_mean_auc"},
       {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "legendFormat": "7-day average",
        "expr": "avg_over_time(distillate_delayed_label_mean_auc[7d])"}]},
    {"type": "text", "title": "Gate history (Phase 3)", "id": 20,
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 60},
     "options": {"mode": "markdown", "content": "Gate pass/fail per candidate is exported by the CI gate in Phase 3 (v4 section 6: \"gate history exported for the Grafana panel\")."}}
  ]
}
