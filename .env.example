# Distillate environment template

# ---- Google Cloud ----
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1
GCS_DATA_BUCKET=your-team-distillate-data          # private: raw text, DVC cache, drift batches, feedback
GCS_ARTIFACTS_BUCKET=your-team-distillate-artifacts # models and MLflow artifacts
ARTIFACT_REGISTRY_REPO=distillate
CLOUD_RUN_API_SERVICE=distillate-api
CLOUD_RUN_DEMO_SERVICE=distillate-demo
# Leave empty to use `gcloud auth application-default login` locally.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=distillate
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ---- Airflow (docker compose) ----
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me
DRIFT_BATCH_SIZE=2000
DRIFT_SCHEDULE_MINUTES=5          # demo pace; a real deployment would run weekly
CANARY_INTERVAL_MINUTES=10

# ---- Teacher labeling (Kaggle) ----
# Only needed to trigger Kaggle runs from the command line; notebooks read their
# own credentials from Kaggle Secrets.
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=                          # only if a gated model is used

# ---- Serving API ----
API_PORT=8000
MODEL_PATH=models/student.onnx
MODEL_VERSION=local-dev
MAX_INPUT_CHARS=5000
RATE_LIMIT_PER_MINUTE=60
LOG_RAW_TEXT=false                 # must stay false; monitoring stores a hash, length, and scores

# ---- Monitoring and alerts ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# ---- Demo app ----
DEMO_API_URL=http://localhost:8000
QUEUE_PAGE_PASSWORD=change-me
FEEDBACK_LOG_URI=gs://your-team-distillate-data/feedback/
STORE_CONSENTED_TEXT=true          # visitor text is saved only when they tick the consent box
