# Distillate environment template

# ---- Google Cloud ----
GCP_PROJECT_ID=distillate-mlops
GCP_REGION=us-east1
GCS_DATA_BUCKET=distillate-mlops-data
GCS_ARTIFACTS_BUCKET=your-team-distillate-artifacts # models and MLflow artifacts
ARTIFACT_REGISTRY_REPO=distillate
CLOUD_RUN_API_SERVICE=distillate-api
CLOUD_RUN_DEMO_SERVICE=distillate-demo
# Leave empty to use `gcloud auth application-default login` locally.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Google Cloud credentials for dvc push ---------------------------------
# Where `gcloud auth application-default login` saved your credentials. Compose
# mounts this read-only so the dvc_version task can push.
#   macOS / Linux : /Users/<you>/.config/gcloud   (or $HOME/.config/gcloud)
#   Windows       : C:\Users\<you>\.config\gcloud
# Leave empty if you are not pushing to GCS; dvc push then warns and the run
# still succeeds. Do not use $HOME here -- Compose does not set it on Windows.
GCLOUD_CONFIG_DIR=

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=distillate
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ---- Airflow (docker compose) ----
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me
DRIFT_BATCH_SIZE=2000
DRIFT_SCHEDULE_MINUTES=5          # demo pace; a real deployment would run weekly
CANARY_INTERVAL_MINUTES=10

# ---- DVC ----
# false keeps a fresh clone and CI green without GCP credentials; dvc_version
# still runs `dvc add` and only skips the push.
DVC_PUSH=false

# ---- Kaggle (acquire + teacher labeling) ----
# Kaggle now issues OAuth access tokens; kaggle.json is the legacy path.
# Everything below comes from https://www.kaggle.com/settings/api
#
# Preferred, and the one that works in Docker: copy the access token shown on
# that page into KAGGLE_API_TOKEN. The client checks it before anything else,
# and docker-compose passes it into the Airflow containers via env_file.
KAGGLE_API_TOKEN=
#
# Legacy fallback: on the same page, under "Legacy API Credentials", click
# "Create Legacy API Key" to download kaggle.json, which holds
# {"username": "...", "key": "..."}. Set both only if you use this route, and
# then leave KAGGLE_API_TOKEN empty -- it takes precedence when set.
KAGGLE_USERNAME=
KAGGLE_KEY=
#
# Either way, accept the rules for both competitions first or downloads 403:
#   kaggle.com/c/jigsaw-toxic-comment-classification-challenge/rules
#   kaggle.com/c/jigsaw-unintended-bias-in-toxicity-classification/rules

HF_TOKEN=                          # only if a gated model is used

# ---- Serving API ----
API_PORT=8000
MODEL_PATH=models/student.onnx
MODEL_VERSION=local-dev
MAX_INPUT_CHARS=5000
RATE_LIMIT_PER_MINUTE=60
LOG_RAW_TEXT=false                 # must stay false; monitoring stores a hash, length, and scores

# ---- Monitoring and alerts ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# ---- Demo app ----
DEMO_API_URL=http://localhost:8000
QUEUE_PAGE_PASSWORD=change-me
FEEDBACK_LOG_URI=gs://your-team-distillate-data/feedback/
STORE_CONSENTED_TEXT=true          # visitor text is saved only when they tick the consent box
