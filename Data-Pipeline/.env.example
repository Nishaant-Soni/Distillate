# Distillate data pipeline (Phase 1) environment template.
#
#   cp .env.example .env     # from this folder, not the repo root
#
# Compose reads .env only from its own folder, so this is the Data-Pipeline copy.
# The repo-root .env.example stays the project-wide template for later phases.
# Nothing here is required to run the tests; the DAG needs the Kaggle block.

# ---- Kaggle (acquire) ------------------------------------------------------
# Everything below comes from https://www.kaggle.com/settings/api
#
# Preferred: copy the access token that page shows into KAGGLE_API_TOKEN. The
# client checks it before anything else.
KAGGLE_API_TOKEN=
#
# Legacy fallback: on the same page, under "Legacy API Credentials", click
# "Create Legacy API Key" to download kaggle.json, which holds
# {"username": "...", "key": "..."}. Set both only if you use this route, and
# then leave KAGGLE_API_TOKEN empty -- it takes precedence when set.
KAGGLE_USERNAME=
KAGGLE_KEY=
#
# Accept the rules for BOTH competitions first or every download returns 403:
#   kaggle.com/c/jigsaw-toxic-comment-classification-challenge/rules
#   kaggle.com/c/jigsaw-unintended-bias-in-toxicity-classification/rules

# ---- Airflow (docker compose) ----------------------------------------------
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
AIRFLOW_PORT=8080
AIRFLOW_PARALLELISM=8
# baseline runs the DAG as one sequential chain for the Gantt comparison.
PIPELINE_MODE=optimized

# ---- DVC --------------------------------------------------------------------
# false keeps a fresh clone and CI green with no GCP credentials. The
# dvc_version task still runs `dvc add`; only the push is skipped.
DVC_PUSH=false

# ---- Google Cloud (DVC remote) ----------------------------------------------
GCP_PROJECT_ID=distillate-mlops
GCS_DATA_BUCKET=distillate-mlops-data
# Leave empty to use `gcloud auth application-default login` locally.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Google Cloud credentials for dvc push ---------------------------------
# Where `gcloud auth application-default login` saved your credentials. Compose
# mounts this read-only so the dvc_version task can push.
#   macOS / Linux : /Users/<you>/.config/gcloud   (or $HOME/.config/gcloud)
#   Windows       : C:\Users\<you>\AppData\Roaming\gcloud   (%APPDATA%\gcloud)
# Leave empty if you are not pushing to GCS; dvc push then warns and the run
# still succeeds. Do not use $HOME here -- Compose does not set it on Windows.
GCLOUD_CONFIG_DIR=

# ---- Alerts -----------------------------------------------------------------
# Unset means alerts are logged and not posted, which is the contract.
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
